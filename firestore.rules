rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Primary admin email: jhs34.kr@gmail.com (with backwards compatibility for hoya100304@gmail.com)
      return isSignedIn() && 
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'jhs34.kr@gmail.com' || request.auth.token.email == 'hoya100304@gmail.com'); 
    }

    // Validation
    function isValidNotice(data) {
      let reqKeys = ['title', 'content', 'date'];
      return data.keys().hasAll(reqKeys) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.date is string && data.date.size() <= 100 &&
             (data.keys().hasAny(['createdAt']) ? (data.createdAt is string && data.createdAt.size() <= 100) : true) &&
             (data.keys().hasAny(['fileUrl']) ? (data.fileUrl is string && data.fileUrl.size() <= 2000) : true) &&
             (data.keys().hasAny(['fileName']) ? (data.fileName is string && data.fileName.size() <= 500) : true) &&
             (data.keys().hasAny(['files']) ? (data.files is list && data.files.size() <= 10) : true) &&
             (data.keys().hasAny(['isArchived']) ? (data.isArchived is bool) : true) &&
             (data.keys().hasAny(['archivedAt']) ? (data.archivedAt is string && data.archivedAt.size() <= 100) : true) &&
             (data.keys().hasAny(['validUntil']) ? (data.validUntil is string && data.validUntil.size() <= 100) : true) &&
             (data.keys().hasAny(['link']) ? (data.link is string && data.link.size() <= 2000) : true);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'date']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             (data.keys().hasAny(['description']) ? (data.description is string && data.description.size() <= 1000) : true) &&
             (data.keys().hasAny(['endDate']) ? (data.endDate is string && data.endDate.size() <= 100) : true) &&
             (data.keys().hasAny(['createdAt']) ? (data.createdAt is string && data.createdAt.size() <= 100) : true) &&
             (data.keys().hasAny(['color']) ? (data.color is string && data.color.size() <= 50) : true) &&
             (data.keys().hasAny(['isHoliday']) ? (data.isHoliday is bool) : true) &&
             (data.keys().hasAny(['isArchived']) ? (data.isArchived is bool) : true) &&
             (data.keys().hasAny(['archivedAt']) ? (data.archivedAt is string && data.archivedAt.size() <= 100) : true);
    }

    function isValidDocument(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (data.keys().hasAny(['description']) ? (data.description is string && data.description.size() <= 10000) : true) &&
             (data.keys().hasAny(['createdAt']) ? (data.createdAt is string && data.createdAt.size() <= 100) : true) &&
             (data.keys().hasAny(['fileUrl']) ? (data.fileUrl is string && data.fileUrl.size() <= 2000) : true) &&
             (data.keys().hasAny(['fileName']) ? (data.fileName is string && data.fileName.size() <= 500) : true) &&
             (data.keys().hasAny(['files']) ? (data.files is list && data.files.size() <= 10) : true) &&
             (data.keys().hasAny(['isArchived']) ? (data.isArchived is bool) : true) &&
             (data.keys().hasAny(['archivedAt']) ? (data.archivedAt is string && data.archivedAt.size() <= 100) : true) &&
             (data.keys().hasAny(['link']) ? (data.link is string && data.link.size() <= 2000) : true);
    }

    function isValidSiteInfo(data) {
      return data.keys().hasAll(['content', 'updatedAt']) &&
             data.keys().size() == 2 &&
             data.content is string && data.content.size() <= 10000 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // Timetable Memos Validation
    function isValidTimetableMemo(data) {
      return data.keys().hasAll(['grade', 'department', 'classNumber', 'weekStart', 'dayOfWeek', 'period', 'memo']) &&
             data.keys().size() <= 9 &&
             (data.grade is int || data.grade is float) && data.grade >= 1 && data.grade <= 3 &&
             data.department is string && data.department.size() <= 100 &&
             (data.classNumber is int || data.classNumber is float) && data.classNumber >= 1 && data.classNumber <= 2 &&
             data.weekStart is string && data.weekStart.size() <= 20 &&
             (data.dayOfWeek is int || data.dayOfWeek is float) && data.dayOfWeek >= 0 && data.dayOfWeek <= 4 &&
             (data.period is int || data.period is float) && data.period >= 1 && data.period <= 7 &&
             data.memo is string && data.memo.size() <= 500 &&
             (data.keys().hasAny(['color']) ? (data.color is string && data.color.size() <= 50) : true) &&
             (data.keys().hasAny(['createdAt']) ? (data.createdAt is string && data.createdAt.size() <= 100) : true);
    }

    // Timetable Templates Validation
    function isValidTimetableTemplate(data) {
      return data.keys().hasAll(['grade', 'department', 'classNumber', 'rawTimetable']) &&
             data.keys().size() <= 5 &&
             (data.grade is int || data.grade is float) && data.grade >= 1 && data.grade <= 3 &&
             data.department is string && data.department.size() <= 100 &&
             (data.classNumber is int || data.classNumber is float) && data.classNumber >= 1 && data.classNumber <= 2 &&
             data.rawTimetable is string && data.rawTimetable.size() <= 10000 &&
             (data.keys().hasAny(['updatedAt']) ? (data.updatedAt is string && data.updatedAt.size() <= 100) : true);
    }

    // Subject Colors Validation
    function isValidSubjectColor(data) {
      return data.keys().hasAll(['color']) &&
             data.color is string && data.color.size() <= 50;
    }

    // POS Validation Helpers (supports Korean IDs & PIN-based staff operations while blocking malformed payloads)
    function isValidPosDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 200;
    }

    function isValidPosCategory(data) {
      return data.keys().hasAll(['name']) &&
             data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidPosItem(data) {
      return data.keys().hasAll(['name', 'price']) &&
             data.keys().size() <= 20 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (data.price is int || data.price is float) && data.price >= 0;
    }

    function isValidPosOrder(data) {
      return data.keys().hasAll(['totalAmount', 'paymentMethod', 'items']) &&
             data.keys().size() <= 30 &&
             (data.totalAmount is int || data.totalAmount is float) && data.totalAmount >= 0 &&
             data.paymentMethod in ['CASH', 'TRANSFER'] &&
             data.items is list && data.items.size() <= 200;
    }

    function isValidPosSettlement(data) {
      return data.keys().hasAll(['status']) &&
             data.keys().size() <= 25 &&
             data.status in ['OPEN', 'CLOSED'];
    }

    function isValidPosPreset(data) {
      return data.keys().hasAll(['name', 'categories', 'items']) &&
             data.keys().size() <= 15 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (data.keys().hasAny(['description']) ? (data.description is string && data.description.size() <= 1000) : true) &&
             data.categories is list && data.categories.size() <= 100 &&
             data.items is list && data.items.size() <= 500;
    }

    function isValidPosLog(data) {
      return data.keys().hasAll(['action']) &&
             data.keys().size() <= 20 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 50;
    }

    // Notice Collection
    match /notices/{noticeId} {
      allow read: if true; // Public access to notices
      allow create: if isAdmin() && isValidId(noticeId) && isValidNotice(incoming());
      allow update: if isAdmin() && isValidId(noticeId) && isValidNotice(incoming());
      allow delete: if isAdmin() && isValidId(noticeId);
    }

    // Academic Events Collection
    match /events/{eventId} {
      allow read: if true; // Public access to events
      allow create: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isAdmin() && isValidId(eventId);
    }

    // Documents Collection
    match /documents/{docId} {
      allow read: if true; // Public access to documents
      allow create: if isAdmin() && isValidId(docId) && isValidDocument(incoming());
      allow update: if isAdmin() && isValidId(docId) && isValidDocument(incoming());
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Site Info Collection
    match /siteInfo/{infoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(infoId) && isValidSiteInfo(incoming());
      allow update: if isAdmin() && isValidId(infoId) && isValidSiteInfo(incoming());
      allow delete: if isAdmin() && isValidId(infoId);
    }

    // Timetable Memos Collection
    match /timetable_memos/{memoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(memoId) && isValidTimetableMemo(incoming());
      allow update: if isAdmin() && isValidId(memoId) && isValidTimetableMemo(incoming());
      allow delete: if isAdmin() && isValidId(memoId);
    }

    // Timetable Templates Collection
    match /timetable_templates/{templateId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(templateId) && isValidTimetableTemplate(incoming());
      allow update: if isAdmin() && isValidId(templateId) && isValidTimetableTemplate(incoming());
      allow delete: if isAdmin() && isValidId(templateId);
    }

    // Subject Colors Collection
    match /subject_colors/{subjectName} {
      allow read: if true;
      allow create, update: if isAdmin() && subjectName is string && subjectName.size() <= 128 && isValidSubjectColor(incoming());
      allow delete: if isAdmin();
    }

    // POS Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidPosDocId(categoryId) && isValidPosCategory(incoming());
      allow delete: if isValidPosDocId(categoryId);
    }

    // POS Items & Inventory Collection (individual item delete restricted in UI to Admin; preset replacement supported)
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isValidPosDocId(itemId) && isValidPosItem(incoming());
      allow delete: if isValidPosDocId(itemId);
    }

    // POS Gifticons Collection (deprecated — restricted to verified Google Admin)
    match /gifticons/{gifticonId} {
      allow read, write: if isAdmin();
    }

    // POS Orders Collection (permanent delete restricted to verified Google Admin)
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidPosDocId(orderId) && isValidPosOrder(incoming());
      allow delete: if isAdmin() && isValidPosDocId(orderId);
    }

    // POS Daily Settlements Collection
    match /settlements/{sessionId} {
      allow read: if true;
      allow create, update: if isValidPosDocId(sessionId) && isValidPosSettlement(incoming());
      allow delete: if isValidPosDocId(sessionId);
    }

    // POS Presets Collection (create & update allowed for POS staff with schema validation; delete restricted to verified Google Admin)
    match /pos_presets/{presetId} {
      allow read: if true;
      allow create, update: if isValidPosDocId(presetId) && isValidPosPreset(incoming());
      allow delete: if isAdmin() && isValidPosDocId(presetId);
    }

    // POS Audit & Activity Logs Collection (append-only for staff; deletion restricted to verified Google Admin)
    match /pos_logs/{logId} {
      allow read: if true;
      allow create: if isValidPosDocId(logId) && isValidPosLog(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidPosDocId(logId);
    }
  }
}
