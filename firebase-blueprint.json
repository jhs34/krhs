{
  "entities": {
    "Notice": {
      "title": "Notice",
      "description": "A school notice or announcement.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200, "description": "Title of the notice." },
        "content": { "type": "string", "maxLength": 10000, "description": "Details of the notice." },
        "date": { "type": "string", "format": "date-time", "description": "Notice date (ISO string)." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "validUntil": { "type": "string", "description": "Optional expiration date for auto-archiving." },
        "link": { "type": "string", "maxLength": 2000, "description": "Optional external reference URL." },
        "fileUrl": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "maxLength": 500 },
        "files": { "type": "array", "description": "Attached file links (up to 10)." },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string" }
      },
      "required": ["title", "content", "date", "createdAt"]
    },
    "AcademicEvent": {
      "title": "AcademicEvent",
      "description": "An event in the academic calendar.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "color": { "type": "string", "maxLength": 50 },
        "isHoliday": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string" }
      },
      "required": ["title", "description", "date", "createdAt"]
    },
    "SchoolDocument": {
      "title": "SchoolDocument",
      "description": "Downloadable form or reference document in the school archive.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 10000 },
        "link": { "type": "string", "maxLength": 2000 },
        "fileUrl": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "maxLength": 500 },
        "files": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string" }
      },
      "required": ["title", "createdAt"]
    },
    "SiteInfo": {
      "title": "SiteInfo",
      "description": "Global site information like announcements, updates, contact.",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "updatedAt"]
    },
    "TimetableMemo": {
      "title": "TimetableMemo",
      "description": "Customizable weekly period memos / performance evaluation reminders.",
      "type": "object",
      "properties": {
        "grade": { "type": "integer" },
        "department": { "type": "string" },
        "classNumber": { "type": "integer" },
        "weekStart": { "type": "string" },
        "dayOfWeek": { "type": "integer" },
        "period": { "type": "integer" },
        "memo": { "type": "string" },
        "color": { "type": "string", "description": "Custom color override for exception styling." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["grade", "department", "classNumber", "weekStart", "dayOfWeek", "period", "memo"]
    },
    "TimetableTemplate": {
      "title": "TimetableTemplate",
      "description": "Customizable default repeating class timetable template.",
      "type": "object",
      "properties": {
        "grade": { "type": "integer" },
        "department": { "type": "string" },
        "classNumber": { "type": "integer" },
        "rawTimetable": { "type": "string" }
      },
      "required": ["grade", "department", "classNumber", "rawTimetable"]
    },
    "SubjectColor": {
      "title": "SubjectColor",
      "description": "Default theme color config for repeating subjects.",
      "type": "object",
      "properties": {
        "color": { "type": "string" }
      },
      "required": ["color"]
    },
    "PosCategory": {
      "title": "PosCategory",
      "description": "Category for POS menu items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "orderIndex": { "type": "number" }
      },
      "required": ["name", "orderIndex"]
    },
    "PosItem": {
      "title": "PosItem",
      "description": "Store inventory product for POS",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "isFavorite": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "categoryId", "price", "stock"]
    },
    "PosGifticon": {
      "title": "PosGifticon",
      "description": "Store discount gifticon with face value and status",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "usedAt": { "type": "string" },
        "usedOrderId": { "type": "string" }
      },
      "required": ["amount", "status"]
    },
    "PosOrder": {
      "title": "PosOrder",
      "description": "Order transaction log for POS",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "timestamp": { "type": "string" },
        "handlerUid": { "type": "string" },
        "handlerName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "totalAmount": { "type": "number" },
        "gifticonDiscountAmount": { "type": "number" },
        "actualPaidAmount": { "type": "number" },
        "items": { "type": "array" },
        "isCancelled": { "type": "boolean" }
      },
      "required": ["sessionId", "handlerUid", "paymentMethod", "totalAmount", "items", "isCancelled"]
    },
    "PosSettlement": {
      "title": "PosSettlement",
      "description": "Daily or shift settlement report for POS",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "initialCash": { "type": "number" },
        "transferSales": { "type": "number" },
        "cashSales": { "type": "number" },
        "totalSales": { "type": "number" },
        "grossSales": { "type": "number" },
        "gifticonSales": { "type": "number" },
        "actualCashInput": { "type": "number" },
        "discrepancy": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["status"]
    },
    "PosPreset": {
      "title": "PosPreset",
      "description": "Saved menu preset with categories and items for POS",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "categories": { "type": "array" },
        "items": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "categories", "items"]
    },
    "PosAuditLog": {
      "title": "PosAuditLog",
      "description": "Audit and activity log of POS transactions, inventory updates, settlements, gifticons, and operations.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "action": { "type": "string" },
        "actionTitle": { "type": "string" },
        "category": { "type": "string" },
        "actorName": { "type": "string" },
        "actorUid": { "type": "string" },
        "details": { "type": "string" },
        "sessionId": { "type": "string" }
      },
      "required": ["timestamp", "action", "actionTitle", "category", "actorName", "details"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/PosCategory" },
      "description": "POS categories"
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/PosItem" },
      "description": "POS items and inventory"
    },
    "/gifticons/{gifticonId}": {
      "schema": { "$ref": "#/entities/PosGifticon" },
      "description": "POS discount gifticons"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/PosOrder" },
      "description": "POS transaction orders"
    },
    "/settlements/{sessionId}": {
      "schema": { "$ref": "#/entities/PosSettlement" },
      "description": "POS daily settlement records"
    },
    "/pos_presets/{presetId}": {
      "schema": { "$ref": "#/entities/PosPreset" },
      "description": "POS preset templates"
    },
    "/pos_logs/{logId}": {
      "schema": { "$ref": "#/entities/PosAuditLog" },
      "description": "POS audit and activity logs"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Collection of school notices."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/AcademicEvent" },
      "description": "Collection of academic calendar events."
    },
    "/documents/{docId}": {
      "schema": { "$ref": "#/entities/SchoolDocument" },
      "description": "Collection of downloadable school documents and forms."
    },
    "/siteInfo/{infoId}": {
      "schema": { "$ref": "#/entities/SiteInfo" },
      "description": "Global information snippets."
    },
    "/timetable_memos/{memoId}": {
      "schema": { "$ref": "#/entities/TimetableMemo" },
      "description": "Collection of weekly class period memo overrides."
    },
    "/timetable_templates/{templateId}": {
      "schema": { "$ref": "#/entities/TimetableTemplate" },
      "description": "Collection of customizable default repeating class timetable templates."
    },
    "/subject_colors/{subjectName}": {
      "schema": { "$ref": "#/entities/SubjectColor" },
      "description": "Collection of custom default theme colors for repeating subjects."
    }
  }
}
